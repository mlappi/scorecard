CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE SEQUENCE PUBLIC.SEQUENCE AS INTEGER START WITH 1 INCREMENT BY 10
CREATE MEMORY TABLE PUBLIC.COURSE(ID BIGINT NOT NULL PRIMARY KEY,NAME VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.GAME(ID BIGINT NOT NULL PRIMARY KEY,BET DOUBLE,DATE TIMESTAMP,NAME VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.HOLE(ID BIGINT NOT NULL PRIMARY KEY,HCP INTEGER NOT NULL,HOLE INTEGER NOT NULL,PAR INTEGER,COURSE_ID BIGINT,CONSTRAINT FKLYD18AFDNL7AHVPT9AQRFDYUL FOREIGN KEY(COURSE_ID) REFERENCES PUBLIC.COURSE(ID))
CREATE MEMORY TABLE PUBLIC.PLAYER(ID BIGINT NOT NULL PRIMARY KEY,EMAIL VARCHAR(255),FIRST_NAME VARCHAR(255) NOT NULL,HCP DOUBLE,LAST_NAME VARCHAR(255) NOT NULL)
CREATE MEMORY TABLE PUBLIC.ROUND(ID BIGINT NOT NULL PRIMARY KEY,BET DOUBLE,DATE TIMESTAMP,NAME VARCHAR(255),COURSE_ID BIGINT,GAME_ID BIGINT,CONSTRAINT UKK7NE7FM38GOU5LQQPJIB3KFYH UNIQUE(COURSE_ID),CONSTRAINT FK6K9K1JCYBNS2CBJAC3LXJBIK1 FOREIGN KEY(COURSE_ID) REFERENCES PUBLIC.COURSE(ID),CONSTRAINT FKPPXONWN9E98LCCY46M2EVE67M FOREIGN KEY(GAME_ID) REFERENCES PUBLIC.GAME(ID))
CREATE MEMORY TABLE PUBLIC.SCORECARD(ID BIGINT NOT NULL PRIMARY KEY,HOLE1 INTEGER,HOLE10 INTEGER,HOLE11 INTEGER,HOLE12 INTEGER,HOLE13 INTEGER,HOLE14 INTEGER,HOLE15 INTEGER,HOLE16 INTEGER,HOLE17 INTEGER,HOLE18 INTEGER,HOLE2 INTEGER,HOLE3 INTEGER,HOLE4 INTEGER,HOLE5 INTEGER,HOLE6 INTEGER,HOLE7 INTEGER,HOLE8 INTEGER,HOLE9 INTEGER,WIN DOUBLE NOT NULL,PLAYER_ID BIGINT,ROUND_ID BIGINT,CONSTRAINT UK_PLAYER_ROUND UNIQUE(PLAYER_ID,ROUND_ID),CONSTRAINT FK15PP458HCF0UPO51N9YOOF4CR FOREIGN KEY(PLAYER_ID) REFERENCES PUBLIC.PLAYER(ID),CONSTRAINT FKTND898RL3108GP8HK1F14XDR6 FOREIGN KEY(ROUND_ID) REFERENCES PUBLIC.ROUND(ID))
