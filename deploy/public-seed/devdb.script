CREATE SCHEMA PUBLIC AUTHORIZATION DBA
CREATE SEQUENCE PUBLIC.SEQUENCE AS INTEGER START WITH 1 INCREMENT BY 10
CREATE MEMORY TABLE PUBLIC.COURSE(ID BIGINT NOT NULL PRIMARY KEY,NAME VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.GAME(ID BIGINT NOT NULL PRIMARY KEY,DATE TIMESTAMP,NAME VARCHAR(255))
CREATE MEMORY TABLE PUBLIC.HOLE(ID BIGINT NOT NULL PRIMARY KEY,HCP INTEGER NOT NULL,HOLE INTEGER NOT NULL,PAR INTEGER,COURSE_ID BIGINT,CONSTRAINT FKLYD18AFDNL7AHVPT9AQRFDYUL FOREIGN KEY(COURSE_ID) REFERENCES PUBLIC.COURSE(ID))
CREATE MEMORY TABLE PUBLIC.PLAYER(ID BIGINT NOT NULL PRIMARY KEY,EMAIL VARCHAR(255),EXTERNAL_USER_ID BIGINT,FIRST_NAME VARCHAR(255) NOT NULL,HCP DOUBLE,LAST_NAME VARCHAR(255) NOT NULL,CONSTRAINT UK9OWRH4R36O7T99HOF0GVP8MT4 UNIQUE(EXTERNAL_USER_ID))
CREATE MEMORY TABLE PUBLIC.ROUND(ID BIGINT NOT NULL PRIMARY KEY,BASIC_SKIN BOOLEAN DEFAULT FALSE NOT NULL,BET DOUBLE,DATE TIMESTAMP,NAME VARCHAR(255),COURSE_ID BIGINT,GAME_ID BIGINT,CONSTRAINT FK6K9K1JCYBNS2CBJAC3LXJBIK1 FOREIGN KEY(COURSE_ID) REFERENCES PUBLIC.COURSE(ID),CONSTRAINT FKPPXONWN9E98LCCY46M2EVE67M FOREIGN KEY(GAME_ID) REFERENCES PUBLIC.GAME(ID))
CREATE MEMORY TABLE PUBLIC.SCORECARD(ID BIGINT NOT NULL PRIMARY KEY,HOLE1 INTEGER,HOLE10 INTEGER,HOLE11 INTEGER,HOLE12 INTEGER,HOLE13 INTEGER,HOLE14 INTEGER,HOLE15 INTEGER,HOLE16 INTEGER,HOLE17 INTEGER,HOLE18 INTEGER,HOLE2 INTEGER,HOLE3 INTEGER,HOLE4 INTEGER,HOLE5 INTEGER,HOLE6 INTEGER,HOLE7 INTEGER,HOLE8 INTEGER,HOLE9 INTEGER,WIN DOUBLE NOT NULL,PLAYER_ID BIGINT,ROUND_ID BIGINT,EXTERNAL_COMPETITOR_ID VARCHAR(255),PLAY_FORMAT VARCHAR(255),PLAYING_HCP DOUBLE,TEAM_NAME VARCHAR(255),CONSTRAINT UK3ESK79NJYNNTGHQ8UI6A1RKL8 UNIQUE(PLAYER_ID,ROUND_ID),CONSTRAINT FK15PP458HCF0UPO51N9YOOF4CR FOREIGN KEY(PLAYER_ID) REFERENCES PUBLIC.PLAYER(ID),CONSTRAINT FKTND898RL3108GP8HK1F14XDR6 FOREIGN KEY(ROUND_ID) REFERENCES PUBLIC.ROUND(ID),CHECK((PUBLIC.SCORECARD.PLAY_FORMAT) IN (('INDIVIDUAL'),('GREENSOME'),('SCRAMBLE'),('BEST_BALL'),('OTHER_TEAM'))))
CREATE MEMORY TABLE PUBLIC.SCORECARD_PARTICIPANT(SCORECARD_ID BIGINT NOT NULL,PLAYER_ID BIGINT NOT NULL,PRIMARY KEY(SCORECARD_ID,PLAYER_ID),CONSTRAINT FKDRTRL99Y3WPDNXVQ87LS0ONCU FOREIGN KEY(PLAYER_ID) REFERENCES PUBLIC.PLAYER(ID),CONSTRAINT FKB4AFMJBUOSRE48M3CV6QERWHQ FOREIGN KEY(SCORECARD_ID) REFERENCES PUBLIC.SCORECARD(ID))
ALTER SEQUENCE SYSTEM_LOBS.LOB_ID RESTART WITH 1
ALTER SEQUENCE PUBLIC.SEQUENCE RESTART WITH 771
